<Window x:Class="VBA_LAUNCHER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VBA Analyzer Launcher" Height="600" Width="800" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Zona de opțiuni sus -->
            <RowDefinition Height="*"/>
            <!-- Zona centrală: log -->
            <RowDefinition Height="Auto"/>
            <!-- Zona de jos: status + buton -->
        </Grid.RowDefinitions>

        <!-- 🔹 Secțiunea de selecție fișier + opțiuni -->
        <StackPanel Orientation="Vertical" Margin="0,0,0,8" Grid.Row="0">
            <DockPanel Margin="0,0,0,5" LastChildFill="True">
                <!-- butonul înainte, ancorat la dreapta -->
                <Button x:Name="btnFwd"
                    Content="▶️"
                    Padding="12,2"
                    DockPanel.Dock="Right"
                    Click="BtnFwd_Click"
                    FontFamily="Consolas" Height="30" Width="36" Visibility="Hidden"/>

                <!-- grup stânga: path + browse -->
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtPath" Width="400"/>
                    <Button x:Name="btnBrowse" Content="Browse..."
                Margin="10,0,0,0"
                Click="Browse_Click"
                Width="100"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,5,0,0">
                <!-- Dreapta -->
                <StackPanel x:Name="LogOptions" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Logger Verbosity:" Margin="0,0,10,0"/>
                    <RadioButton x:Name="rbQuiet" Content="Silent" GroupName="Verbose"/>
                    <RadioButton x:Name="rbNormal" Content="Normal" GroupName="Verbose" IsChecked="True" Margin="10,0,0,0"/>
                    <RadioButton x:Name="rbVerbose" Content="Verbose" GroupName="Verbose" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Stânga -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkCache" Content="Load data from cache" Margin="0,0,10,0" ToolTip="'C:\ExportVBA\cache.dat' must exist!"/>
                    <CheckBox x:Name="chkParallel" Content="Run parallel processing" Margin="0,0,20,0" ToolTip="Faster, but produces chaotic logs"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" >
                    <TextBlock Text="Log Filter:" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtSearch"
                 Width="260"
                 Visibility="Collapsed"
                 ToolTip="Filter log lines (INCLUDES)...."
                 TextChanged="txtSearch_TextChanged"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- 🔹 Zona principală de log -->
        <RichTextBox x:Name="txtLog"
                     Grid.Row="1"
                     IsReadOnly="True"
                     Margin="0,15,0,0"
                     VerticalScrollBarVisibility="Auto">
            <FlowDocument PagePadding="0"
                          FontFamily="Consolas"
                          FontSize="12"
                          LineHeight="13"
                          LineStackingStrategy="BlockLineHeight">
                <FlowDocument.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </FlowDocument.Resources>
                <Paragraph/>
            </FlowDocument>
        </RichTextBox>

        <!-- 🔹 Zona de jos (status + buton) -->
        <DockPanel x:Name="footer"
           Grid.Row="2"
           Margin="0,10,0,0"
           HorizontalAlignment="Stretch"
           LastChildFill="False">

            <!-- Butonul la dreapta -->
            <Button x:Name="btnStart"
            Content="🚀 Start Analysis"
            Height="40"
            Width="200"
            DockPanel.Dock="Right"
            Margin="0,0,0,0"
            Click="Start_Click"/>

            <!-- Textul la stânga -->
            <TextBlock x:Name="lblStatus"
               Foreground="Gray"
               VerticalAlignment="Bottom"
               DockPanel.Dock="Left"
               TextAlignment="Left"
               Margin="10,10,10,10"
               Text="Status: ready..." />
        </DockPanel>
    </Grid>
</Window>
