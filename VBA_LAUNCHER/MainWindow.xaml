<Window x:Class="VBA_LAUNCHER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VBA Analyzer Launcher" Height="480" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock Text="Selectează fișierul Access (.accdb / .mdb):" FontWeight="Bold" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,5">
                <TextBox x:Name="txtPath" Width="400" Margin="0,0,10,0"/>
                <Button Content="Browse..." Width="100" Click="Browse_Click"/>
            </DockPanel>
            <CheckBox x:Name="chkCache" Content="Încarcă din cache" Margin="0,5,0,0"/>
            <CheckBox x:Name="chkParallel" Content="Procesare paralelă" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <RadioButton x:Name="rbQuiet" Content="Silent" GroupName="Verbose"/>
                <RadioButton x:Name="rbNormal" Content="Normal" GroupName="Verbose" IsChecked="True" Margin="10,0,0,0"/>
                <RadioButton x:Name="rbVerbose" Content="Verbose" GroupName="Verbose" Margin="10,0,0,0"/>
            </StackPanel>
            <Button x:Name="btnStart" Content="🚀 Start Analiză" Height="40" Margin="0,10,0,0" Click="Start_Click"/>
        </StackPanel>

        <RichTextBox x:Name="txtLog" Grid.Row="1" IsReadOnly="True" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="lblStatus" Grid.Row="2" TextAlignment="Center" Margin="0,10,0,0" Foreground="Gray"/>
    </Grid>
</Window>
