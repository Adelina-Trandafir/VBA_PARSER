<Window x:Class="VBA_VIEWER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVACONT Viewer" Background="#fafafa">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <DockPanel LastChildFill="True">
        <!-- Bara de sus -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#e9e9e9" Height="36">
            <Button x:Name="btnBack" Content="◀️" Margin="8,4,0,4" Padding="12,2"
                Click="BtnBack_Click" FontFamily="Consolas" Width="36"/>
            <TextBlock Text="AVACONT Viewer" FontSize="14" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="15,0,0,0" Visibility="Hidden"/>
        </StackPanel>

        <!-- Grid principal – ocupă tot spaţiul rămas -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- stânga: search + tree -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ToggleButton group -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <RadioButton Content="No Grouping" IsChecked="True" Margin="0,0,10,0" GroupName="GroupingOptions" Checked="RbNoGroup_Checked"/>
                    <RadioButton Content="Group By Type" Margin="0,0,10,0" GroupName="GroupingOptions" Checked="RbGroupByType_Checked"/>
                    <RadioButton Content="Group by Reference" GroupName="GroupingOptions" Checked="RbGroupByRef_Checked"/>
                </StackPanel>
                <!-- TextBox with Placeholder -->
                <Grid Grid.Row="1" Margin="5">
                    <TextBox x:Name="txtSearch" Height="26" FontSize="13" TextChanged="TxtSearch_TextChanged" FontFamily="Consolas" UndoLimit="118" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Search..." Foreground="Gray" FontSize="13" IsHitTestVisible="False"
                   Margin="5,0,0,0" VerticalAlignment="Center"
                   Visibility="{Binding ElementName=txtSearch, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" FontFamily="Consolas"/>
                </Grid>
                <TreeView x:Name="treeMain" Grid.Row="2" Margin="5"
              SelectedItemChanged="TreeMain_SelectedItemChanged"
              FontFamily="Segoe UI" FontSize="13"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#ddd"/>

            <!-- dreapta: detalii -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtDetails" Grid.Row="0" Margin="5"
                     FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" IsReadOnly="True"/>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#ddd"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="lstSubElements" Grid.Column="0" Margin="5"
                         SelectionChanged="LstSubElements_SelectionChanged"
                         FontFamily="Consolas" FontSize="11"/>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#ddd"/>

                    <RichTextBox x:Name="txtSubDetail" Grid.Column="2" Margin="0"
                         Padding="1"
                         FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         IsDocumentEnabled="True"
                         IsReadOnly="True"/>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
