<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VBA_CORE Live Inspector" Height="750" Width="1100"
        FontFamily="Consolas" FontSize="12">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ComboBox + Refresh -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Global Collection:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cboGlobals" Width="350" SelectionChanged="cboGlobals_SelectionChanged"/>
            <Button Content="Refresh" Margin="10,0" Width="80"/>
            <Button x:Name="btnCancel" Content="Cancel" Margin="5,0" Width="80" IsEnabled="False"/>
        </StackPanel>

        <!-- Progress Bar -->
        <ProgressBar x:Name="progressBar" Grid.Row="1" Height="20" Margin="0,0,0,10" 
                     Minimum="0" Maximum="100" Value="0"/>

        <!-- TreeView -->
        <TreeView x:Name="tvData" Grid.Row="2"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"/>
    </Grid>
</Window>